# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit)
.env*
scratch/

# scripts, sql migrations and sensitive data
/scripts/
*.sql
!database/migrations/*.sql
*.pdf
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OCR models
*.traineddata

# agent generated rules
AGENTS.md
CLAUDE.md
